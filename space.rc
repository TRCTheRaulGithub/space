IDD_DEFINEDRESDIALOG DIALOG DISCARDABLE  0, 0, 117, 81
STYLE DS_MODALFRAME | WS_POPUP
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,3,60,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,55,60,50,14
    CTEXT           "Define your Max Resolution:\n( 15 < x < 1025, 15 < y < 769 ) x shoul be multiple of 4\nexample: X= 204 Y=131",
                    IDC_STATIC,9,2,97,37,WS_BORDER
    EDITTEXT        IDC_X_RENDER,13,44,36,14,ES_CENTER | ES_AUTOHSCROLL | 
                    ES_NUMBER
    EDITTEXT        IDC_Y_RENDER,61,44,40,14,ES_CENTER | ES_AUTOHSCROLL | 
                    ES_NUMBER
    LTEXT           "X:",IDC_STATIC,3,50,8,8
    LTEXT           "Y:",IDC_STATIC,53,50,8,8
END

IDD_ABOUT DIALOGEX 0, 0, 187, 95
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "About Space"
FONT 8, "MS Sans Serif"
BEGIN
